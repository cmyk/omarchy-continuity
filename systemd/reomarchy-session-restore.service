[Unit]
Description=Continuity for Omarchy: restore desktop session
Documentation=https://github.com/cmyk/omarchy-session-restore
Wants=xdg-desktop-portal.service
After=graphical-session.target xdg-desktop-portal.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/reomarchy-session restore --execute --startup
TimeoutStartSec=90
Nice=10
