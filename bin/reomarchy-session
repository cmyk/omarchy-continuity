#!/usr/bin/env bash
set -euo pipefail

readonly PROGRAM_NAME="reomarchy-session"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/reomarchy-session"
readonly DEFAULT_STATE_FILE="$STATE_DIR/session.json"
readonly LOCK_FILE="$STATE_DIR/session.lock"

state_file="$DEFAULT_STATE_FILE"
quiet=false
declare -A RESTORED_ADDRESS_BY_SAVED=()

usage() {
  cat <<'EOF'
Usage:
  reomarchy-session snapshot [--output PATH] [--quiet]
  reomarchy-session plan [--input PATH]
  reomarchy-session restore [--input PATH] [--execute] [--startup]

Commands:
  snapshot  Save restorable Hyprland windows and their workspaces atomically.
  plan      Print what would be restored without changing the desktop.
  restore   Plan by default; pass --execute to launch missing applications.

The default state file is:
  $XDG_STATE_HOME/reomarchy-session/session.json
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

restore_status_show() {
  local attempts=0
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  command -v omarchy >/dev/null 2>&1 || return 0

  # The restore timer normally fires after the shell is ready. Keep a short
  # retry here as a harmless backstop on especially slow logins.
  while ((attempts < 20)); do
    if omarchy-shell osd ping >/dev/null 2>&1; then
      omarchy osd --icon '󰑓' --message 'Restoring session…' --duration 0 >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.1
    ((attempts += 1))
  done
}

restore_status_close() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell -q osd close >/dev/null 2>&1 || true
}

restore_status_complete() {
  command -v omarchy >/dev/null 2>&1 || return 0
  omarchy osd --icon '󰄬' --message 'Session restored' --duration 1800 >/dev/null 2>&1 || true
}

proc_cmdline() {
  local pid="$1"
  [[ -r "/proc/$pid/cmdline" ]] || return 0
  tr '\0' ' ' <"/proc/$pid/cmdline" | sed 's/[[:space:]]*$//' || true
}

proc_cwd() {
  local pid="$1"
  readlink -e "/proc/$pid/cwd" 2>/dev/null || printf '%s' "$HOME"
}

proc_tree() {
  local pid="$1"
  pstree -ap "$pid" 2>/dev/null || true
}

terminal_cwd() {
  local pid="$1"
  local arg next_is_dir=false child
  local -a args=()

  if [[ -r "/proc/$pid/cmdline" ]]; then
    mapfile -d '' -t args <"/proc/$pid/cmdline" || true
  fi
  for arg in "${args[@]}"; do
    if $next_is_dir; then
      [[ -d "$arg" ]] && { printf '%s' "$arg"; return; }
      next_is_dir=false
    fi
    case "$arg" in
      --working-directory=*)
        arg="${arg#--working-directory=}"
        [[ -d "$arg" ]] && { printf '%s' "$arg"; return; }
        ;;
      --working-directory|--dir|-d) next_is_dir=true ;;
    esac
  done

  child="$(pgrep -P "$pid" | head -n 1 || true)"
  [[ -n "$child" ]] && { proc_cwd "$child"; return; }
  proc_cwd "$pid"
}

terminal_launch_json() {
  local cwd="$1"
  local command="$2"
  jq -cn --arg dir "--dir=$cwd" --arg command "$command" \
    '["xdg-terminal-exec", $dir, "--", $command]'
}

plain_shell_cwd() {
  local terminal_pid="$1" child executable cwd
  local -a children=() grandchildren=()

  mapfile -t children < <(pgrep -P "$terminal_pid" 2>/dev/null || true)
  ((${#children[@]} == 1)) || return 1
  child="${children[0]}"
  executable="$(basename -- "$(readlink -f "/proc/$child/exe" 2>/dev/null || true)")"
  case "$executable" in
    bash|dash|fish|nu|zsh) ;;
    *) return 1 ;;
  esac
  mapfile -t grandchildren < <(pgrep -P "$child" 2>/dev/null || true)
  ((${#grandchildren[@]} == 0)) || return 1
  cwd="$(proc_cwd "$child")"
  [[ "$cwd" == "$HOME" || "$cwd" == "$HOME/"* ]] || cwd="$HOME"
  printf '%s' "$cwd"
}

desktop_data_dirs() {
  local -a system_dirs=()
  local directory
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
  IFS=: read -r -a system_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for directory in "${system_dirs[@]}"; do
    [[ -n "$directory" ]] && printf '%s\n' "$directory"
  done
}

desktop_entry_path() {
  local desktop_id="$1" directory path
  [[ "$desktop_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  while IFS= read -r directory; do
    path="$directory/applications/$desktop_id.desktop"
    [[ -f "$path" ]] || continue
    grep -Fqx 'Type=Application' "$path" 2>/dev/null || continue
    grep -Eq '^(Hidden|NoDisplay)=true$' "$path" 2>/dev/null && continue
    printf '%s' "$path"
    return 0
  done < <(desktop_data_dirs)
  return 1
}

desktop_id_for_class() {
  local directory file desktop_id
  local -a application_dirs=()
  if [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && desktop_entry_path "$1" >/dev/null; then
    printf '%s' "$1"
    return 0
  fi
  while IFS= read -r directory; do
    [[ -d "$directory/applications" ]] || continue
    application_dirs+=("$directory/applications")
    file="$(find "$directory/applications" -maxdepth 1 -type f -iname "$1.desktop" -print -quit 2>/dev/null)"
    if [[ -n "$file" ]]; then
      desktop_id="$(basename -- "$file" .desktop)"
      if desktop_entry_path "$desktop_id" >/dev/null; then
        printf '%s' "$desktop_id"
        return 0
      fi
    fi
  done < <(desktop_data_dirs)

  ((${#application_dirs[@]} > 0)) || return 1
  command -v rg >/dev/null 2>&1 || return 1
  while IFS= read -r file; do
    desktop_id="$(basename -- "$file" .desktop)"
    if desktop_entry_path "$desktop_id" >/dev/null; then
      printf '%s' "$desktop_id"
      return 0
    fi
  done < <(rg -l -i -F -x --glob '*.desktop' "StartupWMClass=$1" "${application_dirs[@]}" 2>/dev/null || true)
  return 1
}

classify_client() {
  local class="$1"
  local pid="$2"
  local title="$3"
  local initial_title="$4"
  local cwd tree adapter auto_restore group_key launch notes folder desktop_id

  cwd="$HOME"
  tree=""
  adapter="unsupported"
  auto_restore=false
  group_key="pid:$pid"
  launch='[]'
  notes="No safe restore adapter yet"

  case "${class,,}" in
    1password)
      adapter="onepassword"
      auto_restore=true
      group_key="app:1password"
      launch='["gtk-launch", "1password"]'
      notes="Restores the locked 1Password window through its desktop entry"
      ;;
    chromium|google-chrome|google-chrome-stable)
      if [[ "$initial_title" == "x.com_/" ]]; then
        adapter="chromium-webapp"
        auto_restore=true
        group_key="webapp:https://x.com/"
        launch='["omarchy-launch-webapp", "https://x.com/"]'
        notes="Restores the X web app independently from browser tabs"
      else
        adapter="chromium"
        auto_restore=true
        group_key="browser:chromium"
        launch='["omarchy-launch-browser", "--restore-last-session"]'
        notes="Chromium restores its own windows and tabs"
      fi
      ;;
    org.gnome.nautilus|nautilus)
      adapter="files"
      auto_restore=true
      group_key="files:nautilus"
      folder="$HOME"
      case "$title" in
        Desktop|Documents|Downloads|Music|Pictures|Public|Templates|Videos)
          folder="$(xdg-user-dir "${title^^}" 2>/dev/null || printf '%s' "$HOME")"
          ;;
        *)
          # Nautilus uses the basename as its title for ordinary folders.
          # Restore it when that title resolves unambiguously below $HOME.
          [[ -d "$HOME/$title" ]] && folder="$HOME/$title"
          ;;
      esac
      launch="$(jq -cn --arg folder "$folder" '["nautilus", "--new-window", $folder]')"
      notes="Restores the last recognizable folder below the home directory"
      ;;
    foot|alacritty|kitty|com.mitchellh.ghostty)
      cwd="$(terminal_cwd "$pid")"
      tree="$(proc_tree "$pid")"
      if grep -Eq '(^|[^[:alnum:]_])herdr,' <<<"$tree"; then
        adapter="herdr"
        auto_restore=true
        group_key="terminal:herdr"
        launch="$(terminal_launch_json "$cwd" herdr)"
        notes="Herdr restores its saved layout and exact agent session"
      elif grep -Eq '(^|[^[:alnum:]_])btop,' <<<"$tree"; then
        adapter="terminal-command"
        auto_restore=true
        group_key="terminal:btop:$pid"
        launch="$(terminal_launch_json "$cwd" btop)"
        notes="Restores allow-listed terminal command btop"
      elif cwd="$(plain_shell_cwd "$pid")"; then
        adapter="terminal-shell"
        auto_restore=true
        group_key="terminal:shell:${class,,}"
        launch="$(jq -cn --arg dir "--dir=$cwd" '["xdg-terminal-exec", $dir]')"
        notes="Restores a clean shell in its saved working directory without replaying commands"
      else
        notes="Terminal has a non-allow-listed child command and is not replayed"
      fi
      ;;
    *)
      if desktop_id="$(desktop_id_for_class "$class")"; then
        adapter="desktop-app"
        auto_restore=true
        group_key="desktop:$desktop_id"
        launch="$(jq -cn --arg desktopId "$desktop_id" '["gtk-launch", $desktopId]')"
        notes="Restores an installed desktop application through its validated desktop ID"
      fi
      ;;
  esac

  jq -cn \
    --arg adapter "$adapter" \
    --arg groupKey "$group_key" \
    --arg cwd "$cwd" \
    --arg commandLine "$(proc_cmdline "$pid")" \
    --arg notes "$notes" \
    --argjson autoRestore "$auto_restore" \
    --argjson launch "$launch" \
    '{adapter: $adapter, autoRestore: $autoRestore, groupKey: $groupKey,
      cwd: $cwd, commandLine: $commandLine, launch: $launch, notes: $notes}'
}

snapshot() {
  local output="$DEFAULT_STATE_FILE"
  local clients active tmp manifest='[]' client class pid title initial_title classification item count

  while (($#)); do
    case "$1" in
      --output) [[ $# -ge 2 ]] || die "--output needs a path"; output="$2"; shift 2 ;;
      --quiet) quiet=true; shift ;;
      -h|--help) usage; return ;;
      *) die "unknown snapshot option: $1" ;;
    esac
  done

  require_command hyprctl
  require_command jq
  require_command pstree
  clients="$(hyprctl clients -j)"
  active="$(hyprctl activeworkspace -j)"

  while IFS= read -r client; do
    class="$(jq -r '.class // .initialClass // ""' <<<"$client")"
    [[ -n "$class" ]] || continue
    [[ "$class" != org.omarchy.* ]] || continue
    pid="$(jq -r '.pid // 0' <<<"$client")"
    [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 0)) || continue
    title="$(jq -r '.title // ""' <<<"$client")"
    initial_title="$(jq -r '.initialTitle // ""' <<<"$client")"
    classification="$(classify_client "$class" "$pid" "$title" "$initial_title")"
    item="$(jq -cn --argjson client "$client" --argjson classification "$classification" '
      {
        address: ($client.address // ""),
        class: ($client.class // ""),
        initialClass: ($client.initialClass // ""),
        title: (if $classification.adapter == "onepassword" then "1Password" else ($client.title // "") end),
        initialTitle: (if $classification.adapter == "onepassword" then "1Password" else ($client.initialTitle // "") end),
        pid: ($client.pid // 0),
        workspace: {
          id: ($client.workspace.id // 0),
          name: ($client.workspace.name // "")
        },
        monitor: ($client.monitor // 0),
        geometry: {at: ($client.at // [0,0]), size: ($client.size // [0,0])},
        floating: ($client.floating // false),
        pinned: ($client.pinned // false),
        fullscreen: ($client.fullscreen // 0),
        focusHistoryID: ($client.focusHistoryID // -1)
      } + $classification')"
    manifest="$(jq -cn --argjson items "$manifest" --argjson item "$item" '$items + [$item]')"
  done < <(jq -c '.[] | select(.mapped == true and .hidden != true and (.workspace.id // 0) > 0)' <<<"$clients")

  count="$(jq '[.[] | select(.autoRestore)] | length' <<<"$manifest")"
  if ((count == 0)); then
    $quiet || printf 'No restorable windows found; keeping the previous snapshot.\n'
    return 0
  fi

  mkdir -p "$STATE_DIR" "$(dirname "$output")"
  exec 9>"$LOCK_FILE"
  flock 9
  tmp="$(mktemp "$(dirname "$output")/.session.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  jq -n \
    --arg capturedAt "$(date --iso-8601=seconds)" \
    --arg host "$(hostname)" \
    --argjson active "$active" \
    --argjson clients "$manifest" \
    '{schemaVersion: 1, capturedAt: $capturedAt, host: $host,
      activeWorkspace: {id: ($active.id // 1), name: ($active.name // "1")},
      clients: $clients}' >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$output"
  trap - RETURN
  $quiet || printf 'Saved %s restorable windows to %s\n' "$count" "$output"
}

read_state_option() {
  while (($#)); do
    case "$1" in
      --input) [[ $# -ge 2 ]] || die "--input needs a path"; state_file="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  REMAINING_ARGS=("$@")
}

validate_state() {
  [[ -r "$state_file" ]] || die "no saved session at $state_file"
  jq -e '.schemaVersion == 1 and (.clients | type == "array")' "$state_file" >/dev/null \
    || die "invalid session file: $state_file"
}

plan() {
  read_state_option "$@"
  ((${#REMAINING_ARGS[@]} == 0)) || die "unknown plan option: ${REMAINING_ARGS[0]}"
  validate_state

  printf 'Saved %s — active workspace %s\n\n' \
    "$(jq -r '.capturedAt' "$state_file")" "$(jq -r '.activeWorkspace.name' "$state_file")"
  printf '%-10s  %-18s  %-9s  %s\n' WORKSPACE ADAPTER ACTION TITLE
  jq -r '
    .clients
    | sort_by(.workspace.id, .focusHistoryID)
    | .[]
    | [(.workspace.name | tostring), .adapter,
       (if .autoRestore then "restore" else "skip" end), .title]
    | @tsv' "$state_file" \
    | while IFS=$'\t' read -r workspace adapter action title; do
        printf '%-10s  %-18s  %-9s  %s\n' "$workspace" "$adapter" "$action" "$title"
      done
}

live_has_adapter() {
  local adapter="$1"
  local class="$2"
  local initial_title="${3:-}"
  local clients pid tree
  clients="$(hyprctl clients -j)"

  case "$adapter" in
    chromium) jq -e --arg class "$class" 'any(.[];
      (((.class // "") | ascii_downcase) == ($class | ascii_downcase))
      and ((.initialTitle // "") != "x.com_/"))' <<<"$clients" >/dev/null ;;
    chromium-webapp) jq -e --arg class "$class" --arg initialTitle "$initial_title" 'any(.[];
      (((.class // "") | ascii_downcase) == ($class | ascii_downcase))
      and ((.initialTitle // "") == $initialTitle))' <<<"$clients" >/dev/null ;;
    onepassword) jq -e 'any(.[]; ((.class // "") | ascii_downcase) == "1password")' \
      <<<"$clients" >/dev/null ;;
    desktop-app) jq -e --arg class "$class" 'any(.[];
      ((.class // "") | ascii_downcase) == ($class | ascii_downcase))' \
      <<<"$clients" >/dev/null ;;
    files) jq -e 'any(.[]; (.class // "") == "org.gnome.Nautilus")' <<<"$clients" >/dev/null ;;
    herdr|terminal-command)
      while IFS= read -r pid; do
        tree="$(proc_tree "$pid")"
        if [[ "$adapter" == herdr ]] && grep -Eq '(^|[^[:alnum:]_])herdr,' <<<"$tree"; then return 0; fi
        if [[ "$adapter" == terminal-command ]] && grep -Eq '(^|[^[:alnum:]_])btop,' <<<"$tree"; then return 0; fi
      done < <(jq -r '.[] | select((.class // "") | ascii_downcase | IN("foot", "alacritty", "kitty", "com.mitchellh.ghostty")) | .pid' <<<"$clients")
      return 1
      ;;
    *) return 1 ;;
  esac
}

launch_argv_direct() {
  local adapter="$1" launch="$2" unit
  local -a argv=()

  jq -e --arg adapter "$adapter" --arg home "$HOME" '
    type == "array" and length > 0 and all(.[]; type == "string") and
    (if $adapter == "chromium" then
       . == ["omarchy-launch-browser", "--restore-last-session"]
     elif $adapter == "chromium-webapp" then
       . == ["omarchy-launch-webapp", "https://x.com/"]
     elif $adapter == "onepassword" then
       . == ["gtk-launch", "1password"]
     elif $adapter == "desktop-app" then
       length == 2 and .[0] == "gtk-launch" and
       (.[1] | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
     elif $adapter == "files" then
       length == 3 and .[0] == "nautilus" and .[1] == "--new-window" and
       (.[2] == $home or (.[2] | startswith($home + "/")))
     elif $adapter == "terminal-shell" then
       length == 2 and .[0] == "xdg-terminal-exec" and
       (.[1] == "--dir=" + $home or (.[1] | startswith("--dir=" + $home + "/")))
     elif $adapter == "herdr" or $adapter == "terminal-command" then
       length == 4 and .[0] == "xdg-terminal-exec" and .[2] == "--" and
       (.[1] == "--dir=" + $home or (.[1] | startswith("--dir=" + $home + "/"))) and
       (if $adapter == "herdr" then .[3] == "herdr" else .[3] == "btop" end)
     else false end)' <<<"$launch" >/dev/null \
    || die "refusing invalid $adapter launch command in $state_file"

  mapfile -d '' -t argv < <(jq -j '.[] | ., "\u0000"' <<<"$launch")

  if [[ "$adapter" == desktop-app ]]; then
    desktop_entry_path "${argv[1]}" >/dev/null \
      || die "refusing missing desktop ID ${argv[1]} in $state_file"
  fi

  unit="reomarchy-session-launch-$(date +%s%N)"
  systemd-run --user --quiet --collect --unit="$unit" \
    --property=StandardOutput=null --property=StandardError=null \
    -- "${argv[@]}"
}

lua_quote() {
  jq -Rn --arg value "$1" '$value'
}

new_addresses_for_class() {
  local class="$1"
  local before="$2"
  hyprctl clients -j | jq -r --arg class "$class" --argjson before "$before" '
    .[] | select(((.class // "") | ascii_downcase) == ($class | ascii_downcase))
    | select((.address as $a | $before | index($a)) == null) | .address'
}

missing_terminal_shell_group() {
  local group="$1" clients saved saved_class saved_cwd saved_workspace
  local address pid workspace live_class live_cwd candidate missing='[]'
  local -A used_addresses=()
  clients="$(hyprctl clients -j)"

  while IFS= read -r saved; do
    saved_class="$(jq -r '.class' <<<"$saved")"
    saved_cwd="$(jq -r '.cwd' <<<"$saved")"
    saved_workspace="$(jq -r '.workspace.name' <<<"$saved")"
    candidate=""
    while IFS=$'\t' read -r address pid workspace live_class; do
      [[ -z "${used_addresses[$address]:-}" ]] || continue
      [[ "${live_class,,}" == "${saved_class,,}" && "$workspace" == "$saved_workspace" ]] || continue
      live_cwd="$(plain_shell_cwd "$pid" 2>/dev/null || true)"
      if [[ -n "$live_cwd" && "$live_cwd" == "$saved_cwd" ]]; then
        candidate="$address"
        break
      fi
    done < <(jq -r '.[] | [.address, .pid, .workspace.name, .class] | @tsv' <<<"$clients")

    if [[ -n "$candidate" ]]; then
      used_addresses[$candidate]=1
    else
      missing="$(jq -cn --argjson items "$missing" --argjson item "$saved" '$items + [$item]')"
    fi
  done < <(jq -c 'sort_by(.focusHistoryID)[]' <<<"$group")
  printf '%s' "$missing"
}

apply_window_state() {
  local saved="$1"
  local address="$2"
  local selector selector_lua floating fullscreen pinned x y width height

  selector="address:$address"
  selector_lua="$(lua_quote "$selector")"
  floating="$(jq -r '.floating // false' <<<"$saved")"
  fullscreen="$(jq -r '.fullscreen // 0' <<<"$saved")"
  pinned="$(jq -r '.pinned // false' <<<"$saved")"
  x="$(jq -r '.geometry.at[0] // 0' <<<"$saved")"
  y="$(jq -r '.geometry.at[1] // 0' <<<"$saved")"
  width="$(jq -r '.geometry.size[0] // 0' <<<"$saved")"
  height="$(jq -r '.geometry.size[1] // 0' <<<"$saved")"

  if [[ "$floating" == true ]]; then
    hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = $selector_lua })" >/dev/null || true
    if ((width > 0 && height > 0)); then
      hyprctl dispatch "hl.dsp.window.resize({ x = $width, y = $height, relative = false, window = $selector_lua })" >/dev/null || true
      hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = $selector_lua })" >/dev/null || true
    fi
  else
    hyprctl dispatch "hl.dsp.window.float({ action = \"disable\", window = $selector_lua })" >/dev/null || true
    # Launch order recreates the tiled topology; exact pixel resizing restores
    # the saved split proportions and lets the layout resize sibling windows.
    if ((width > 0 && height > 0)); then
      hyprctl dispatch "hl.dsp.window.resize({ x = $width, y = $height, relative = false, window = $selector_lua })" >/dev/null || true
    fi
  fi

  if [[ "$pinned" == true ]]; then
    hyprctl dispatch "hl.dsp.window.pin({ action = \"enable\", window = $selector_lua })" >/dev/null || true
  fi

  case "$fullscreen" in
    1) hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"enable\", window = $selector_lua })" >/dev/null || true ;;
    2|3) hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"enable\", window = $selector_lua })" >/dev/null || true ;;
  esac
}

restore_tiled_order() {
  local saved saved_address address target_x target_y current_x current_y geometry
  local direction selector_lua attempts original_workspace
  original_workspace="$(hyprctl activeworkspace -j | jq -r '.name')"

  while IFS= read -r saved; do
    saved_address="$(jq -r '.address' <<<"$saved")"
    address="${RESTORED_ADDRESS_BY_SAVED[$saved_address]:-}"
    [[ -n "$address" ]] || continue
    target_x="$(jq -r '.geometry.at[0]' <<<"$saved")"
    target_y="$(jq -r '.geometry.at[1]' <<<"$saved")"
    selector_lua="$(lua_quote "address:$address")"

    attempts=0
    while ((attempts < 32)); do
      geometry="$(hyprctl clients -j | jq -r --arg address "$address" '
        .[] | select(.address == $address) | [.at[0], .at[1]] | @tsv')"
      [[ -n "$geometry" ]] || break
      IFS=$'\t' read -r current_x current_y <<<"$geometry"
      ((current_x == target_x && current_y == target_y)) && break
      if ((current_x > target_x)); then direction=l
      elif ((current_x < target_x)); then direction=r
      elif ((current_y > target_y)); then direction=u
      else direction=d
      fi
      hyprctl dispatch "hl.dsp.focus({ window = $selector_lua })" >/dev/null || break
      hyprctl dispatch "hl.dsp.window.swap({ direction = \"$direction\" })" >/dev/null || break
      ((attempts += 1))
    done
  done < <(jq -c '[.clients[] | select(.autoRestore and (.floating | not))]
    | sort_by(.workspace.id, .geometry.at[1], .geometry.at[0])[]' "$state_file")

  hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_quote "$original_workspace") })" >/dev/null || true
  return 0
}

reapply_restored_window_states() {
  local saved saved_address address
  while IFS= read -r saved; do
    saved_address="$(jq -r '.address' <<<"$saved")"
    address="${RESTORED_ADDRESS_BY_SAVED[$saved_address]:-}"
    if [[ -n "$address" ]]; then
      apply_window_state "$saved" "$address"
    fi
  done < <(jq -c '.clients[] | select(.autoRestore)' "$state_file")
  return 0
}

launch_group() {
  local group="$1"
  local first adapter class initial_title launch
  local expected before='[]' address_count=0 attempts=0 title_matches=0 live_clients
  local launch_attempt=0 max_launch_attempts=1
  local -a addresses=()

  first="$(jq -c '.[0]' <<<"$group")"
  adapter="$(jq -r '.adapter' <<<"$first")"
  class="$(jq -r '.class' <<<"$first")"
  initial_title="$(jq -r '.initialTitle // ""' <<<"$first")"
  launch="$(jq -c '.launch' <<<"$first")"
  expected="$(jq 'length' <<<"$group")"

  if [[ "$adapter" == terminal-shell ]]; then
    group="$(missing_terminal_shell_group "$group")"
    expected="$(jq 'length' <<<"$group")"
    if ((expected == 0)); then
      printf 'skip     %-18s already restored\n' "$adapter"
      return 0
    fi
    first="$(jq -c '.[0]' <<<"$group")"
    launch="$(jq -c '.launch' <<<"$first")"
  elif live_has_adapter "$adapter" "$class" "$initial_title"; then
    printf 'skip     %-18s already running\n' "$adapter"
    return 0
  fi

  before="$(hyprctl clients -j | jq '[.[].address]')"
  case "$adapter" in
    chromium-webapp|onepassword) max_launch_attempts=2 ;;
  esac
  while ((launch_attempt < max_launch_attempts)); do
    ((launch_attempt += 1))
    if [[ "$adapter" == terminal-shell ]]; then
      while IFS= read -r launch; do
        printf 'launch   %-18s %s\n' "$adapter" "$(jq -r '@sh' <<<"$launch")"
        launch_argv_direct "$adapter" "$launch"
      done < <(jq -c 'sort_by(.focusHistoryID)[] | .launch' <<<"$group")
    else
      if ((launch_attempt == 1)); then
        printf 'launch   %-18s %s\n' "$adapter" "$(jq -r '@sh' <<<"$launch")"
      else
        printf 'retry    %-18s application is now settled\n' "$adapter"
      fi
      launch_argv_direct "$adapter" "$launch"
    fi

    attempts=0
    while ((attempts < 100)); do
      mapfile -t addresses < <(new_addresses_for_class "$class" "$before")
      address_count="${#addresses[@]}"
      ((address_count >= expected)) && break
      sleep 0.1
      ((attempts += 1))
    done
    ((address_count >= expected)) && break
    ((launch_attempt < max_launch_attempts)) || break

    # An autostarted application can have a background process before it is
    # ready to create its saved window. Give a delayed window time to appear
    # before retrying, avoiding duplicates.
    sleep 5
    mapfile -t addresses < <(new_addresses_for_class "$class" "$before")
    address_count="${#addresses[@]}"
    ((address_count >= expected)) && break
  done

  if ((address_count == 0)); then
    printf 'warning: %s launched %d time(s) but no matching window appeared\n' \
      "$adapter" "$launch_attempt" >&2
    return 0
  fi

  # Browser windows often appear before their restored page titles. Give exact
  # title matching a short chance so creation order does not swap workspaces.
  attempts=0
  while ((attempts < 50)); do
    live_clients="$(hyprctl clients -j)"
    title_matches="$(jq -n \
      --argjson saved "$group" \
      --argjson live "$live_clients" \
      --argjson addresses "$(printf '%s\n' "${addresses[@]}" | jq -R . | jq -s .)" '
      [$saved[] as $s | $live[]
        | select((.address as $a | $addresses | index($a)) != null)
        | select((.title // "") == $s.title)] | length')"
    ((title_matches >= expected)) && break
    sleep 0.1
    ((attempts += 1))
  done

  local index=0 saved saved_address saved_title workspace address address_selector workspace_lua address_lua current_workspace candidate
  local -A used_addresses=()
  while IFS= read -r saved && ((index < address_count)); do
    saved_title="$(jq -r '.title' <<<"$saved")"
    workspace="$(jq -r '.workspace.name' <<<"$saved")"
    live_clients="$(hyprctl clients -j)"
    candidate="$(jq -r --arg title "$saved_title" \
      --argjson addresses "$(printf '%s\n' "${addresses[@]}" | jq -R . | jq -s .)" '
      .[] | select((.address as $a | $addresses | index($a)) != null)
      | select((.title // "") == $title) | .address' <<<"$live_clients" | head -n 1)"
    if [[ -n "$candidate" && -z "${used_addresses[$candidate]:-}" ]]; then
      address="$candidate"
    else
      address=""
      for candidate in "${addresses[@]}"; do
        if [[ -z "${used_addresses[$candidate]:-}" ]]; then address="$candidate"; break; fi
      done
    fi
    [[ -n "$address" ]] || break
    used_addresses[$address]=1
    saved_address="$(jq -r '.address' <<<"$saved")"
    RESTORED_ADDRESS_BY_SAVED[$saved_address]="$address"
    current_workspace="$(hyprctl clients -j | jq -r --arg address "$address" '.[] | select(.address == $address) | .workspace.name')"
    if [[ "$current_workspace" != "$workspace" ]]; then
      address_selector="address:$address"
      workspace_lua="$(lua_quote "$workspace")"
      address_lua="$(lua_quote "$address_selector")"
      hyprctl dispatch "hl.dsp.window.move({ workspace = $workspace_lua, follow = false, window = $address_lua })" >/dev/null || true
    fi
    apply_window_state "$saved" "$address"
    ((index += 1))
  done < <(jq -c 'sort_by(.focusHistoryID)[]' <<<"$group")
}

restore() {
  local execute=false startup=false active groups group
  read_state_option "$@"
  set -- "${REMAINING_ARGS[@]}"
  while (($#)); do
    case "$1" in
      --execute) execute=true; shift ;;
      --startup) startup=true; shift ;;
      *) die "unknown restore option: $1" ;;
    esac
  done
  validate_state

  if ! $execute; then
    plan --input "$state_file"
    printf '\nDry run only. Use restore --execute to launch missing applications.\n'
    return
  fi

  require_command hyprctl
  require_command systemd-run
  if $startup; then
    restore_status_show
    trap 'restore_status_close' EXIT
  fi

  groups="$(jq -c '[.clients[] | select(.autoRestore)] | group_by(.groupKey)' "$state_file")"
  while IFS= read -r group; do
    launch_group "$group"
  done < <(jq -c '.[]' <<<"$groups")

  restore_tiled_order
  reapply_restored_window_states

  active="$(jq -r '.activeWorkspace.name // .activeWorkspace.id // "1"' "$state_file")"
  hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_quote "$active") })" >/dev/null || true
  if $startup; then
    restore_status_complete
    trap - EXIT
  else
    printf 'Restore pass complete. Applications with their own session engine may still be loading.\n'
  fi
}

main() {
  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 1; }
  shift
  case "$command" in
    snapshot) snapshot "$@" ;;
    plan) plan "$@" ;;
    restore) restore "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
